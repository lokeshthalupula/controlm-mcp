# ---------------------------------------------------------------------------
# Control-M Automation API endpoint (9.22.x)
# ---------------------------------------------------------------------------
CONTROLM_BASE_URL=https://controlm-aapi.example.com:8443/automation-api

# ---------------------------------------------------------------------------
# Credentials. Either username/password OR a pre-issued API token.
# NEVER commit real credentials. Use a secret manager in production.
# ---------------------------------------------------------------------------
CONTROLM_USERNAME=
CONTROLM_PASSWORD=
CONTROLM_TOKEN=

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# Set to false ONLY for non-production self-signed environments.
CONTROLM_TLS_REJECT_UNAUTHORIZED=true
# Optional PEM bundle for a private CA.
CONTROLM_CA_CERT_PATH=

# ---------------------------------------------------------------------------
# HTTP behaviour
# ---------------------------------------------------------------------------
CONTROLM_TIMEOUT_MS=60000
CONTROLM_MAX_RETRIES=3
CONTROLM_RETRY_BASE_DELAY_MS=500
CONTROLM_RETRY_MAX_DELAY_MS=8000
CONTROLM_PROXY_URL=

# ---------------------------------------------------------------------------
# Token lifecycle
# ---------------------------------------------------------------------------
# Proactive refresh window, in seconds, before the token is considered stale.
CONTROLM_TOKEN_TTL_SECONDS=1800
CONTROLM_TOKEN_REFRESH_SKEW_SECONDS=120

# ---------------------------------------------------------------------------
# OpenAPI-driven tool generation
# ---------------------------------------------------------------------------
# Local path or http(s) URL to the Control-M swagger/openapi document.
# When unset the server tries <BASE_URL>/swagger.json then /openapi.json.
CONTROLM_OPENAPI_PATH=./.github/OpenAPI-YAML.yaml
CONTROLM_OPENAPI_URL=
# Enable/disable automatic generation of one MCP tool per operationId.
CONTROLM_ENABLE_OPENAPI_TOOLS=true
# Comma separated allow/deny lists of operationIds or tag names (glob supported).
CONTROLM_OPENAPI_INCLUDE=
CONTROLM_OPENAPI_EXCLUDE=
# Guard against exposing thousands of tools to the model.
CONTROLM_OPENAPI_MAX_TOOLS=400
# Prefix applied to generated tool names.
CONTROLM_OPENAPI_TOOL_PREFIX=ctm_

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# Start safely: block write operations until they are explicitly needed.
CONTROLM_READ_ONLY=true
# Keep multi-step remediation disabled until explicitly reviewed.
CONTROLM_ALLOW_REMEDIATION=false

# ---------------------------------------------------------------------------
# Logging: error | warn | info | debug | trace
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Copilot workflow defaults (can be overridden per tool call)
# ---------------------------------------------------------------------------
# Agents upgraded concurrently per batch by upgrade_fleet.
CONTROLM_FLEET_BATCH_SIZE=5
# Hard cap on hosts touched by a single upgrade_fleet campaign.
CONTROLM_FLEET_MAX_HOSTS=50
# Fraction of failed upgrades that aborts an upgrade_fleet campaign.
CONTROLM_FLEET_ABORT_FAILURE_RATE=0.25
# Default alert page size for collect_diagnostics and generate_report.
CONTROLM_ALERT_LIMIT=200
# Default monitoring budget, in seconds, for run_job_and_monitor.
CONTROLM_JOB_MONITOR_TIMEOUT_SECONDS=1800
# Default agent probe concurrency for agent_health_report.
CONTROLM_HEALTH_PROBE_CONCURRENCY=6
